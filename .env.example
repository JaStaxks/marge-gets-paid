# PayPal sandbox REST app (developer.paypal.com → Apps & Credentials → Sandbox)
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_CLIENT_SECRET=
# Aliases accepted by the app and scripts/verify-sandbox.mjs
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=

# Same client id, exposed to the PayPal JS SDK (PayPal + Venmo buttons).
# The pay page also reads the server env at runtime via /api/paypal/config.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_ENV=sandbox

# Sandbox webhook id, after the deploy URL exists.
PAYPAL_WEBHOOK_ID=

# Google AI Studio key for Gemini. GOOGLE_GENERATIVE_AI_API_KEY is also accepted.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Owner desk password. If unset, the demo password is coastline.
DASHBOARD_PASSWORD=coastline

# Public URL used in deposit links and PayPal return URLs.
APP_BASE_URL=http://localhost:3000

# Optional. Invoice recipient for scripts/verify-sandbox.mjs and a hint for judges.
PAYPAL_SANDBOX_BUYER_EMAIL=

# Persistence. Local `next dev` uses data/store.json when these are empty.
# On Vercel, create a free Upstash Redis database (Vercel Marketplace) and set either pair:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Set to 1 to force the in-app PayPal mock even when sandbox keys are present.
# PAYPAL_FORCE_MOCK=0
